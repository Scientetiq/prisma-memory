      "steps": [
        {
          "action": "trigger",
          "source": "new email",
          "id": "trigger"
        },
        {
          "action": "sign",
          "script": "sign.js",
          "operation": "post",
          "inputs": [
            "base_url",
            "connector_id",
            "signing_secret",
            "event_id",
            "variant",
            "source"
          ],
          "id": "sign"
        },
        {
          "action": "http",
          "method": "POST",
          "url": "sign.url",
          "headers": "sign.headers",
          "body": "sign.body",
          "body_mode": "raw",
          "follow_redirects": false,
          "accept": [
            200,

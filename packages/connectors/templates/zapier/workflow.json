{
  "platform": "zapier",
  "format": "setup-recipe",
  "version": 1,
  "importable": false,
  "verification": "Signing code tested against the real handler; platform runtime not verified live.",
  "variants": [
    {
      "id": "mail",
      "source_fields": {
        "id": "stable source item id",
        "text": "plain text body",
        "subject": "optional title"

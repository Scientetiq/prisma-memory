    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "jose": "6.2.12",
    "ldapts": "9.2.0",
    "minio": "^8.0.5",
    "nodemailer": "10.6.1",
    "pg": "^8.23.0",
    "uuid": "^11.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

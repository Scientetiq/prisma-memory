{
  "name": "@memory/shared",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-Prisma-Memory",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ldap": "./src/ldap.ts",
    "./settings": "./src/settings.ts",
    "./crypto": "./src/crypto.ts",
    "./factor": "./src/factor.ts",
    "./db-pool": "./src/db.ts",
    "./credentials": "./src/credentials.ts",
    "./external-notices": "./src/external-notices.ts",
    "./settings-key": "./src/settings-key.ts",
    "./settings-tier": "./src/settings-tier.ts",
    "./ldap-account": "./src/ldap-account.ts",
    "./service-env": "./src/service-env.ts",
    "./edge-settings": "./src/edge-settings.ts",
    "./oauth-as": "./src/oauth-as/index.ts"
  },
  "description": "Shared by the gateway and the workers: connections by role, settings with encrypted secrets, identifiers, error codes and data markers, contracts, the platform gateway client, logs without content",

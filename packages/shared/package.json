    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "contracts:gen": "node scripts/gen-contracts.mjs",
    "contracts:check": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "@memory/i18n": "workspace:*",
    "@memory/mcp-core": "workspace:*",
    "@memory/wire": "workspace:*",

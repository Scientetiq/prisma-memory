{
  "name": "prisma-memory",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-Prisma-Memory",
  "description": "Prisma Memory for AI agents: MCP and REST gateway, pipeline workers, schema of four databases, admin panel",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:test": "bash contracts/schema/test-schema.sh",
    "db:introspect:check": "pnpm --filter @memory/db introspect:check",
    "contracts:gen": "pnpm --filter @memory/shared contracts:gen",
    "contracts:check": "pnpm --filter @memory/shared contracts:check",
    "wire:gen": "node tools/edge/gen-login-kinds.mjs && node tools/edge/gen-bridge-types.mjs && node tools/edge/gen-anchors-schema.mjs",
    "edge:build": "node tools/edge/build.mjs",
    "edge:check": "node tools/edge/check_isolation.mjs --build && node --import tsx --test 'tools/edge/test/*.test.mjs'"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "pnpm": {
    "ignoredOptionalDependencies": ["sharp"],
    "overrides": {
      "fast-uri@<3.1.9": "3.1.9",
      "fast-xml-parser@<5.12.0": "5.12.0",
      "source-map-js@<1.2.2": "1.2.2",
      "zod@<4.6.6": "4.6.6"
    }
  }
}

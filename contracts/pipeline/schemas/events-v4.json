{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory.internal/pipeline/schemas/events-v4.json",
  "title": "Output of the events stage (events-v4)",
  "description": "Events of four kinds from a transcript, each with a verbatim quote. The model sets no time, class, space or owner: code determines them.",
  "type": "object",
  "required": [
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "statement",
          "quote",
          "certainty"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "action",
              "question_risk",
              "fact"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "A short heading of the event"
          },
          "statement": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600,
            "description": "The point in your own words, one or two sentences"
          },
          "quote": {
            "type": "string",
            "minLength": 10,
            "maxLength": 600,
            "description": "A verbatim excerpt of the transcript, 1–3 sentences; code checks that it occurs"
          },
          "actors": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "description": "Labels or names as in the text: for an action, who is to do it; for a decision, who decided; for the rest, who said it"
          },
          "mentions": {
            "type": "array",
            "maxItems": 20,
            "description": "Mentions of entities as written in the text; code links them to the registry",
            "items": {
              "type": "object",
              "required": [
                "text",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "company",
                    "deal",
                    "person",
                    "project",
                    "document",
                    "other"
                  ]
                }
              }
            }
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600,
            "description": "The rationale (for decisions), if it was said"
          },
          "alternatives": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Rejected alternatives, if they were said"
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60,
            "description": "The deadline of an action, as in the text"
          },
          "certainty": {
            "type": "string",
            "enum": [
              "extracted",
              "inferred",
              "ambiguous"
            ],
            "description": "extracted: said directly; inferred: follows from what was said; ambiguous: can be read more than one way"
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Notes on the quality of the source: a cut-off, poor recognition"
    }
  }
}
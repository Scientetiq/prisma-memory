{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory.internal/connectors/schemas/meeting.schema.json",
  "title": "meeting",
  "description": "A meeting with its transcript. The language is always sent by the connector (its configured language when the source has none); the item never relies on a server default.",
  "type": "object",
  "required": [
    "type",
    "external_id",
    "started_at",
    "transcript"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "meeting"
    },
    "external_id": {
      "$ref": "item.schema.json#/$defs/ExternalId"
    },
    "external_version": {
      "$ref": "item.schema.json#/$defs/ExternalVersion"
    },
    "title": {
      "$ref": "item.schema.json#/$defs/Title"
    },
    "url": {
      "$ref": "item.schema.json#/$defs/Url"
    },
    "entities": {
      "$ref": "item.schema.json#/$defs/Entities"
    },
    "started_at": {
      "$ref": "item.schema.json#/$defs/Timestamp"
    },
    "duration_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
      }
    },
    "participants": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "type": "object",
            "required": [
              "name"
            ]
          },
          {
            "type": "object",
            "required": [
              "email"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
            }
          },
          "email": {
            "$ref": "item.schema.json#/$defs/Email"
          },
          "attended": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "host",
              "attendee",
              "invitee"
            ]
          }
        }
      }
    },
    "transcript": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000000
            },
            "format": {
              "type": "string",
              "enum": [
                "auto",
                "marked",
                "timeline",
                "srt",
                "vtt",
                "json",
                "plain"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "segments"
          ],
          "additionalProperties": false,
          "properties": {
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20000,
              "items": {
                "type": "object",
                "required": [
                  "start_sec",
                  "end_sec",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "start_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000000
                  },
                  "speaker": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

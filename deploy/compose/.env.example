# Prisma Memory — variables of the public install (deploy/compose/compose.yaml).
#
# `deploy/compose/setup` writes `.env` (mode 0600) from this list: it adds only missing keys and never rewrites one
# you set. You do not need to copy this file by hand. No secret belongs here: passwords and keys are files under
# MEMORY_HOME/secrets/<service>, made once by `setup` with `openssl rand`, mounted read-only at /run/credentials.
# None of these variables is read by the product's code except where a line says so; they shape the containers.

# ---------------------------------------------------------------- required (no default: compose stops without them)
# Name of this install: compose project `prisma-memory-<id>`, the instance row in the databases. Lowercase letters,
# digits, `_` and `-`, at most 63 characters. `setup` writes `core`, or the name given with `--instance NAME`.
MEMORY_INSTANCE_ID=core
# Where the data, the secrets and the sockets live (absolute path, outside this clone). `setup` creates
#   data/{pg,s3,s3-iam,guard,audit-ship}  run/{pg,admin,workplace,cli}  secrets/{db,migrate,gateway,workers,s3,setup}
# all mode 0700, owned by MEMORY_UID:MEMORY_GID. Docker never creates them (create_host_path: false). `setup` writes
# ~/prisma-memory-home of the installing user, or /var/lib/prisma-memory when it runs as root.
MEMORY_HOME=
# One uid:gid for every container: the installing user, or 10001:10001 when `setup` runs as root.
MEMORY_UID=1000
MEMORY_GID=1000
# Tag of the locally built images prisma-memory-{db,app,web,demo-models}. `setup` writes `git describe --tags --always`
# plus `-dirty` when a tracked file has changed, else the content of a VERSION file, else 0.0.0-local. A rerun of
# `setup` requires the recorded version and commit.
MEMORY_VERSION=0.0.0-local

# ---------------------------------------------------------------- written by setup, with a safe default
# Commit of the tree the images were built from (40 hex digits, optionally -dirty, or unknown); read by the gateway
# for /api/v1/health and recorded by the schema step with the schema fingerprint.
MEMORY_COMMIT=unknown
# Deploy profile, read by the gateway and the workers: internet (the default: install code, admin API on a socket,
# loopback only is internal, no http:// public address) or internal-http (a closed company network reached over plain
# HTTP; client addresses of RFC 1918 and ULA count as internal). `development` is for local development only and is
# refused here.
# Note for internal-http: what the gateway does with a zoned IPv6 client address (fe80::1%eth0) is softer outside
# `internet`; the networks of this file are IPv4 only, so no such address reaches it.
MEMORY_DEPLOY_PROFILE=internet
# Name of the instance shown in the panel (the schema step writes it once, on the first start).
MEMORY_INSTANCE_NAME=Prisma Memory

# ---------------------------------------------------------------- published ports (IPv4 only)
# Both listeners are on this host address; 127.0.0.1 keeps them on the server itself. Agents reach the gateway
# through your reverse proxy or an SSH tunnel; the panel through an SSH tunnel:
#   ssh -L 8081:127.0.0.1:8081 you@server   then open http://127.0.0.1:8081
# Another address is allowed only with MEMORY_DEPLOY_PROFILE=internal-http (`setup` refuses it otherwise).
MEMORY_PUBLISH_ADDR=127.0.0.1
# Agents and the API (/mcp, /api/v1). Links the gateway writes into answers name port 8080 until a public address
# is configured (setting access.cloud_agent_base_url or access.public_base_url); with another port setup prints a
# warning line.
GATEWAY_PORT=8080
# Panel and workplace.
WEB_PORT=8081

# ---------------------------------------------------------------- memory limits (setup writes them from the host RAM)
# Profile "4 GB" (RAM below 7,000 MiB) shown. From 7,000 to below 15,000 MiB: db 1g, gateway 1g, workers 1g,
# web 768m, s3 256m, heaps 640/640/480, shared_buffers 256MB. At 15,000 MiB and above: db 4g, gateway 2g,
# workers 2g, web 1536m, s3 512m, shared_buffers 1GB. Rerunning `setup` keeps existing values.
MEMORY_MEM_DB=512m
MEMORY_MEM_MIGRATE=256m
MEMORY_MEM_GATEWAY=512m
MEMORY_MEM_WORKERS=512m
MEMORY_MEM_WEB=384m
MEMORY_MEM_S3=128m
MEMORY_MEM_DEMO_MODELS=256m
# Node heap limits in MB (--max-old-space-size), below the container limits above.
MEMORY_HEAP_GATEWAY=320
MEMORY_HEAP_WORKERS=320
MEMORY_HEAP_WEB=240
# Read by the gateway at start: scrypt runs of local accounts at once, 1 or 2 (each needs 128 MiB besides the heap); 1 on this profile, 2 on the larger ones.
MEMORY_SCRYPT_PARALLEL=1
# PostgreSQL (max_connections is fixed at 100).
MEMORY_PG_SHARED_BUFFERS=128MB
MEMORY_PG_EFFECTIVE_CACHE_SIZE=384MB
MEMORY_PG_WORK_MEM=4MB
MEMORY_PG_SHM_SIZE=128m

# ---------------------------------------------------------------- several installs on one server
# Each install is its own clone (or its own copy of deploy/compose) with its own .env: another MEMORY_INSTANCE_ID
# (the compose project name; `setup --instance NAME`), another MEMORY_HOME (`setup --home DIR`; setup refuses a home
# that another clone's install owns), other GATEWAY_PORT and WEB_PORT. Nothing else is shared: no fixed subnet, no
# named volume, no shared network.
